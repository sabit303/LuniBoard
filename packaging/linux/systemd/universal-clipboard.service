# systemd user unit for distribution packages (binary in /usr/bin).
# Users enable it with: systemctl --user enable --now universal-clipboard.service
# For a ~/.local installation use `universal-clipboard service install` instead,
# which generates an equivalent unit pointing at the installed binary.
[Unit]
Description=Universal Clipboard daemon (LAN clipboard synchronization)
Documentation=https://github.com/universal-clipboard/universal-clipboard
After=network-online.target graphical-session.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/universal-clipboard daemon
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes

[Install]
WantedBy=default.target
