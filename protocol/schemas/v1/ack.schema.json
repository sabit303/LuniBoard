{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.universal-clipboard.org/v1/ack.schema.json",
  "title": "Acknowledgement",
  "type": "object",
  "required": ["event_id", "status"],
  "properties": {
    "event_id": { "$ref": "common.schema.json#/$defs/id" },
    "status": { "enum": ["applied", "duplicate", "stale", "expired", "ignored", "rejected"] },
    "reason": { "type": "string", "maxLength": 256 }
  }
}
